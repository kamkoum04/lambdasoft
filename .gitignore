# build output and caches — regenerated by `npm run build`
dist/
.astro/
node_modules/

# raw working images: not a build input (src/assets/ holds what ships), and the
# folder contains third-party material — a saved Pinterest page and a
# vendor-branded wallpaper — that does not belong in a public repository
image/

# local capture sets live in the OS temp dir, but just in case
*.local
.DS_Store
.env
.env.*
