---
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import { site } from '../site';
import { langOf, pathFor, languages, locales, defaultLang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const lang = langOf(Astro.currentLocale);
/* Both languages point at each other, plus x-default at the default locale.
   x-default used to be `alternates[0]`, which was correct only because `en`
   happens to be declared first in `languages` — reordering that object for
   display reasons would have made French the default for every search engine.
   It now names the locale it means. */
const alternates = locales.map((code) => ({
  code,
  href: new URL(pathFor(code, Astro.url.pathname), Astro.site).href,
}));

/**
 * Structured data, kept to claims that are actually true.
 *
 * Every field here is something a search or answer engine may repeat verbatim,
 * so nothing goes in that we cannot stand behind: no address, no founding date,
 * no employee count, no review rating, no social profiles that do not exist.
 * The contact point appears only once the address is real — publishing a
 * placeholder inbox as machine-readable fact is how it ends up quoted back.
 */
const org = {
  '@type': 'Organization',
  '@id': new URL('/#organization', Astro.site).href,
  name: site.name,
  url: new URL('/', Astro.site).href,
  description: description,
  ...(site.emailIsPlaceholder
    ? {}
    : { contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: site.email } }),
  knowsAbout: [
    'Web application development',
    'Mobile application development',
    'Desktop application development',
    'Cloud infrastructure',
    'Agentic AI',
    'Generative AI',
    'Application security',
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    org,
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      url: new URL('/', Astro.site).href,
      name: site.name,
      description: description,
      publisher: { '@id': org['@id'] },
      inLanguage: lang,
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      /* Arms the brand intro before first paint. Session-scoped and
         motion-gated here, not in the component, so a repeat visit never shows
         a frame of curtain and reduced-motion never shows it at all. */
      try {
        if (
          !matchMedia('(prefers-reduced-motion: reduce)').matches &&
          !sessionStorage.getItem('lambdasoft:intro')
        ) {
          document.documentElement.setAttribute('data-intro', '');
        }
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.code === defaultLang)!.href} />
    <meta name="theme-color" content="#02081c" />
    <meta name="color-scheme" content="dark" />
    {/* The tab icon is the brand mark. The vector comes first deliberately:
        the mark is a raster with real 3D shading, and at 16x16 that shading has
        nowhere to go, so brand/README.md ships favicon-mark.svg as the same
        lambda redrawn flat. Browsers that prefer SVG get the crisp one; the
        PNGs, cut from mark.png, cover everything else. */}
    <link rel="icon" href={`${import.meta.env.BASE_URL}brand/favicon-mark.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}brand/favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}brand/favicon-16.png`} sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}brand/apple-touch-icon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* twitter:card declared summary_large_image with no image, so every link
        preview rendered blank. Absolute URLs — scrapers ignore relative ones. */}
    <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL}brand/og-card.png`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:image" content={new URL(`${import.meta.env.BASE_URL}brand/og-card.png`, Astro.site).href} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <Intro />
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      // The entrance enhances content that is already visible: the hidden state
      // is applied only once we know we can also remove it. Anything on screen
      // at load is shown at once, so nothing above the fold fades in; only what
      // is genuinely below the fold animates as it arrives.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      const targets = document.querySelectorAll<HTMLElement>('.rise');

      if (targets.length && !reduced.matches && 'IntersectionObserver' in window) {
        document.documentElement.setAttribute('data-anim-armed', '');

        const show = (el: HTMLElement) => {
          const delay = Number(el.dataset.animDelay ?? 0);
          window.setTimeout(() => el.classList.add('is-in'), delay);
        };

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              show(entry.target as HTMLElement);
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );

        let started = false;
        const start = () => {
          if (started) return;
          started = true;

          for (const el of targets) {
            if (el.getBoundingClientRect().top < window.innerHeight) {
              show(el);
            } else {
              observer.observe(el);
            }
          }

          // Never leave content hidden if the observer never fires.
          window.setTimeout(() => {
            for (const el of targets) el.classList.add('is-in');
          }, 2500);
        };

        // When the brand intro is playing, the hero's entrance waits for the
        // curtain — otherwise it animates unseen and the reveal shows a page
        // that has already settled. The 6s backstop covers an intro that dies
        // without dispatching; content can survive a broken intro, never the
        // other way round.
        if (document.documentElement.hasAttribute('data-intro')) {
          window.addEventListener('lambda:intro-done', start, { once: true });
          window.setTimeout(start, 6000);
        } else {
          start();
        }
      }
    </script>
  </body>
</html>
