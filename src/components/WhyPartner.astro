---
/**
 * Six reasons, each carrying its own figure.
 *
 * Two earlier attempts were rejected. The first drew flat boxes joined by
 * connector lines, which read as a wiring schematic rather than an
 * illustration. The second replaced them with mock interface panels, which
 * looked like product screenshots and lost the drawn quality entirely.
 *
 * These go back to drawing, but escape flatland: isometric projection for the
 * stacked figures, tilted orbits for the systems, layered depth for the
 * network. Line weight varies, and exactly one element in each figure is lit,
 * so every card has a focal point instead of uniform hairlines everywhere.
 *
 * Stroke alphas are not arbitrary. At 0.38 the structural line composited to
 * 2.73:1 against the panel, under the 3:1 WCAG asks of a meaningful graphic;
 * these are supporting illustration rather than load-bearing diagrams, so it
 * was not strictly a failure, but they also read as washed out. 0.46 measures
 * comfortably past it and the drawings are simply clearer. Do not go lower.
 *
 * The headings follow Koyeb's partner grid at the client's direction. On their
 * page those claims describe a datacentre footprint and a partner customer
 * base; lambdasoft has neither. The bodies are therefore written about how the
 * team builds rather than what it owns. Keep it that way: a heading the
 * paragraph cannot support is the fastest way to lose a technical buyer.
 */

import { useTranslations } from '../i18n/utils';

const line = 'rgb(var(--glacier-ch) / 0.46)';
const faint = 'rgb(var(--glacier-ch) / 0.22)';
const fill = 'rgb(var(--frost-ch) / 0.045)';
const lit = 'rgb(var(--ring-ch) / 0.9)';
const litFill = 'rgb(var(--ring-ch) / 0.12)';

const art = {
  scale: `<svg viewBox="0 0 200 140" fill="none" role="img" aria-label="{ALT}">
      <path d="M14 116 40 103l26 13-26 13z" fill="${fill}" stroke="${line}"/>
      <path d="M14 116v11l26 13v-11M66 116v11l-26 13" stroke="${faint}"/>

      <path d="M78 104 104 91l26 13-26 13z" fill="${fill}" stroke="${line}"/>
      <path d="M78 118 104 105l26 13-26 13z" fill="${fill}" stroke="${line}"/>
      <path d="M78 118v9l26 13v-9M130 118v9l-26 13" stroke="${faint}"/>

      <path d="M142 78 168 65l26 13-26 13z" fill="${litFill}" stroke="${lit}"/>
      <path d="M142 92 168 79l26 13-26 13z" fill="${fill}" stroke="${line}"/>
      <path d="M142 106 168 93l26 13-26 13z" fill="${fill}" stroke="${line}"/>
      <path d="M142 120 168 107l26 13-26 13z" fill="${fill}" stroke="${line}"/>
      <path d="M142 120v8l26 13v-8M194 120v8l-26 13" stroke="${faint}"/>

      <path d="M22 62 76 50l52-16 54-22" stroke="${lit}" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="1 6"/>
      <path d="M172 8h12v12" stroke="${lit}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`,
  global: `<svg viewBox="0 0 200 140" fill="none" role="img" aria-label="{ALT}">
      <circle cx="100" cy="72" r="44" fill="${fill}" stroke="${line}"/>
      <ellipse cx="100" cy="72" rx="44" ry="16" stroke="${faint}"/>
      <ellipse cx="100" cy="72" rx="44" ry="31" stroke="${faint}"/>
      <ellipse cx="100" cy="72" rx="17" ry="44" stroke="${faint}"/>
      <path d="M56 72h88" stroke="${faint}"/>

      <path d="M70 46C86 30 118 32 132 50" stroke="${lit}" stroke-width="1.4" stroke-dasharray="2 5"/>
      <circle cx="70" cy="46" r="4.5" fill="${lit}"/>
      <circle cx="132" cy="50" r="4.5" fill="${lit}"/>
      <circle cx="78" cy="96" r="4.5" fill="${lit}"/>
      <circle cx="126" cy="94" r="3.5" fill="${line}"/>

      <ellipse cx="100" cy="72" rx="62" ry="22" stroke="${lit}" stroke-width="1.3" opacity="0.75" transform="rotate(-22 100 72)"/>
      <circle cx="156" cy="47" r="4" fill="${lit}"/>
    </svg>`,
  support: `<svg viewBox="0 0 200 140" fill="none" role="img" aria-label="{ALT}">
      <circle cx="40" cy="58" r="13" fill="${litFill}" stroke="${lit}" stroke-width="1.5"/>
      <circle cx="160" cy="58" r="13" fill="${litFill}" stroke="${lit}" stroke-width="1.5"/>
      <path d="M53 58h94" stroke="${lit}" stroke-width="1.6"/>
      <path d="M140 52l7 6-7 6" stroke="${lit}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>

      <path d="M62 40a34 34 0 0 1 0 36" stroke="${lit}" opacity="0.5"/>
      <path d="M72 30a50 50 0 0 1 0 56" stroke="${lit}" opacity="0.28"/>
      <path d="M138 40a34 34 0 0 0 0 36" stroke="${lit}" opacity="0.5"/>
      <path d="M128 30a50 50 0 0 0 0 56" stroke="${lit}" opacity="0.28"/>

      <rect x="60" y="106" width="24" height="15" rx="3" stroke="${faint}"/>
      <rect x="88" y="106" width="24" height="15" rx="3" stroke="${faint}"/>
      <rect x="116" y="106" width="24" height="15" rx="3" stroke="${faint}"/>
      <path d="M52 113.5h96" stroke="${faint}" stroke-width="1.4"/>
    </svg>`,
  ecosystem: `<svg viewBox="0 0 200 140" fill="none" role="img" aria-label="{ALT}">
      <ellipse cx="100" cy="70" rx="76" ry="26" stroke="${line}" transform="rotate(-16 100 70)"/>
      <ellipse cx="100" cy="70" rx="76" ry="26" stroke="${faint}" transform="rotate(44 100 70)"/>
      <ellipse cx="100" cy="70" rx="76" ry="26" stroke="${faint}" transform="rotate(-72 100 70)"/>

      <circle cx="100" cy="70" r="18" fill="${litFill}" stroke="${lit}" stroke-width="1.5"/>
      <circle cx="100" cy="70" r="5" fill="${lit}"/>

      <rect x="154" y="36" width="32" height="18" rx="4" fill="${fill}" stroke="${lit}"/>
      <rect x="14" y="86" width="32" height="18" rx="4" fill="${fill}" stroke="${lit}"/>
      <rect x="146" y="98" width="32" height="18" rx="4" fill="${fill}" stroke="${line}"/>
      <rect x="22" y="28" width="32" height="18" rx="4" fill="${fill}" stroke="${line}"/>
      <circle cx="100" cy="12" r="5" fill="${fill}" stroke="${line}"/>
      <circle cx="100" cy="128" r="5" fill="${fill}" stroke="${line}"/>
    </svg>`,
  ai: `<svg viewBox="0 0 200 140" fill="none" role="img" aria-label="{ALT}">
      <path d="M100 30V16" stroke="${line}"/>
      <circle cx="100" cy="12" r="5" fill="${litFill}" stroke="${lit}" stroke-width="1.5"/>

      <rect x="60" y="30" width="80" height="72" rx="20" fill="${fill}" stroke="${line}" stroke-width="1.3"/>

      <rect x="46" y="54" width="11" height="26" rx="5" fill="${fill}" stroke="${faint}"/>
      <rect x="143" y="54" width="11" height="26" rx="5" fill="${fill}" stroke="${faint}"/>

      <rect x="72" y="46" width="56" height="30" rx="13" fill="rgb(var(--void-ch) / 0.55)" stroke="${lit}" stroke-width="1.4"/>
      <path d="M87 61h5M108 61h5" stroke="${lit}" stroke-width="4" stroke-linecap="round"/>

      <rect x="85" y="83" width="30" height="11" rx="5.5" stroke="${faint}"/>
      <path d="M93 86v5M100 86v5M107 86v5" stroke="${faint}" stroke-linecap="round"/>

      <path d="M60 112h80" stroke="${faint}" stroke-dasharray="3 5"/>

      <path d="M166 22C167.4 31.8 170.2 34.6 180 36C170.2 37.4 167.4 40.2 166 50C164.6 40.2 161.8 37.4 152 36C161.8 34.6 164.6 31.8 166 22Z" fill="${lit}"/>
      <path d="M34 96C34.9 102.3 36.7 104.1 43 105C36.7 105.9 34.9 107.7 34 114C33.1 107.7 31.3 105.9 25 105C31.3 104.1 33.1 102.3 34 96Z" fill="${lit}" opacity="0.6"/>
      <path d="M172 96C172.6 100.2 173.8 101.4 178 102C173.8 102.6 172.6 103.8 172 108C171.4 103.8 170.2 102.6 166 102C170.2 101.4 171.4 100.2 172 96Z" fill="${lit}" opacity="0.4"/>
    </svg>`,
  creative: `<svg viewBox="0 0 200 140" fill="none" role="img" aria-label="{ALT}">
      <defs>
        <radialGradient id="lampGlow" cx="50%" cy="42%" r="50%">
          <stop offset="0%" stop-color="rgb(117 209 255)" stop-opacity="0.34"/>
          <stop offset="55%" stop-color="rgb(117 209 255)" stop-opacity="0.09"/>
          <stop offset="100%" stop-color="rgb(117 209 255)" stop-opacity="0"/>
        </radialGradient>
      </defs>

      <circle class="lamp__halo" cx="100" cy="56" r="62" fill="url(#lampGlow)"/>

      <path d="M100 14V4M70 24l-7-7M130 24l7-7M56 56H44M144 56h12M68 88l-9 8M132 88l9 8" stroke="${lit}" stroke-width="1.5" stroke-linecap="round" opacity="0.55"/>

      <circle cx="100" cy="56" r="30" fill="${fill}" stroke="${line}" stroke-width="1.3"/>
      <path d="M88 82v6M112 82v6" stroke="${line}"/>
      <rect x="86" y="88" width="28" height="7" rx="2.5" fill="${fill}" stroke="${line}"/>
      <rect x="88" y="97" width="24" height="6" rx="2.5" fill="${fill}" stroke="${faint}"/>
      <path d="M93 106h14" stroke="${faint}" stroke-linecap="round"/>

      <path d="M94 40 110 72" stroke="${lit}" stroke-width="2.4" stroke-linecap="round"/>
      <path d="M102.6 57 88 72" stroke="${lit}" stroke-width="2.4" stroke-linecap="round"/>
      <path d="M88 72q-4 6 0 10M110 72q4 6 0 10" stroke="${lit}" stroke-width="1.3" opacity="0.6"/>
    </svg>`,
} as const;

const t = useTranslations(Astro.currentLocale);

const cards = ([
  'scale', 'global', 'support', 'ecosystem', 'ai', 'creative',
] as const).map((key) => ({
  ...t.why.cards[key],
  // the drawing is language-neutral; only its description is translated
  art: art[key].replace('{ALT}', t.why.cards[key].alt),
}));
---

<section id="why" class="why">
  <div class="shell">
    <header class="why__head rise">
      <h2>{t.why.heading}</h2>
      <p>{t.why.intro}
      </p>
    </header>

    <ul class="cards">
      {
        cards.map((card, i) => (
          <li class="card rise" data-anim-delay={60 + i * 50}>
            <div class="card__art" set:html={card.art} />
            <h3 class="card__title">{card.title}</h3>
            <p class="card__body">{card.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why {
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }

  .why__head {
    display: grid;
    justify-items: center;
    gap: var(--space-md);
    text-align: center;
    margin-block-end: clamp(2.5rem, 5vw, 4rem);
  }

  .why__head h2 {
    font-size: clamp(2rem, 1.3rem + 2.2vw, 3rem);
    max-width: 18ch;
  }

  .why__head p {
    max-width: 56ch;
    color: var(--ink-muted);
    font-size: var(--text-lead);
    line-height: 1.62;
  }

  .cards {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .card {
    display: grid;
    align-content: start;
    gap: var(--space-sm);
    padding: var(--space-lg);
    border: 1px solid rgb(var(--glacier-ch) / 0.13);
    border-radius: var(--radius-lg);
    /* a step off the page, not a shadow: nothing on this page is raised */
    background: linear-gradient(180deg, rgb(var(--glacier-ch) / 0.045), rgb(var(--glacier-ch) / 0.015));
    transition: border-color var(--dur-base) var(--ease-out-quart);
  }

  .card:hover {
    border-color: rgb(var(--ring-ch) / 0.34);
  }

  .card__art {
    margin-block-end: var(--space-sm);
    padding: var(--space-md) var(--space-sm);
    border-radius: var(--radius-md);
    border: 1px solid rgb(var(--glacier-ch) / 0.08);
    background: rgb(var(--void-ch) / 0.5);
  }

  .card__art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The one glow on the page outside the photograph, and only because the
     subject of the figure is literally a lamp. It breathes slowly rather than
     pulsing: anything faster reads as a notification. */
  .card__art :global(.lamp__halo) {
    transform-origin: 50% 40%;
    animation: lamp-breathe 6s var(--ease-out-quart) infinite;
  }

  @keyframes lamp-breathe {
    0%,
    100% {
      opacity: 0.75;
      transform: scale(0.97);
    }
    50% {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card__art :global(.lamp__halo) {
      animation: none;
    }
  }

  .card__title {
    color: var(--ink);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  .card__body {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  @media (min-width: 64rem) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
