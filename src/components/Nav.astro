---
import { site } from '../site';
import { useTranslations, langOf, pathFor, languages, locales } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const lang = langOf(Astro.currentLocale);
const here = Astro.url.pathname;
---

<header class="bar" data-bar>
  <div class="bar__inner shell">
    <a class="mark" href="#main" aria-label={`${site.name}, ${t.nav.backToTop}`}>
      <img class="mark__glyph" src={`${import.meta.env.BASE_URL}brand/mark.webp`} alt="" width="1600" height="1536" decoding="sync" fetchpriority="high" />
      <span class="mark__word">{site.name}</span>
    </a>

    <nav class="bar__nav" aria-label={t.nav.sections}>
      {t.nav.items.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="bar__end">
      {/* A globe, not flags. A flag names a country, not a language, and the
          French flag would be telling a reader in Montreal or Brussels that
          this translation is not for them. */}
      <nav class="lang" aria-label={t.nav.language}>
        <svg class="lang__globe" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
          <path d="M3 12h18" stroke="currentColor" stroke-width="1.5" />
          <path d="M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" stroke="currentColor" stroke-width="1.5" />
        </svg>

        {locales.map((code) => (
          <a
            class="lang__link"
            href={pathFor(code, here)}
            hreflang={languages[code].htmlLang}
            lang={languages[code].htmlLang}
            aria-current={code === lang ? 'true' : undefined}
          >
            <span aria-hidden="true">{languages[code].short}</span>
            <span class="lang__full">{languages[code].label}</span>
          </a>
        ))}
      </nav>

      <a class="cta bar__cta" href={`mailto:${site.email}`}>
        <span>{t.nav.emailUs}</span>
      <svg class="cta__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h10m0 0-4-4m4 4-4 4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .bar {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-bar);
    background: transparent;
    border-block-end: 1px solid transparent;
    transition:
      background-color var(--dur-base) var(--ease-out-quart),
      border-color var(--dur-base) var(--ease-out-quart);
  }

  /* Over the photograph the bar is invisible. Once the hero has scrolled past
     it becomes a real surface so type never sits on unpredictable pixels. */
  .bar[data-scrolled] {
    background: rgb(var(--void-ch) / 0.72);
    border-block-end-color: rgb(var(--frost-ch) / 0.1);
    backdrop-filter: blur(14px);
  }

  /* Three columns rather than space-between: the centre column stays optically
     centred in the viewport no matter how wide the wordmark or the action get. */
  .bar__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-lg);
    min-height: var(--bar-height);
  }

  .bar__end {
    justify-self: end;
    flex: none;
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 1.4vw, 1rem);
  }

  .lang {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.2rem 0.45rem 0.2rem 0.35rem;
    border: 1px solid rgb(var(--frost-ch) / 0.2);
    border-radius: var(--radius-pill);
  }

  .lang__globe {
    inline-size: 1rem;
    block-size: 1rem;
    color: var(--glacier);
    flex: none;
    margin-inline-end: 0.15rem;
  }

  .lang__link {
    padding: 0.25rem 0.45rem;
    border-radius: var(--radius-pill);
    color: var(--ink-muted);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    line-height: 1;
    transition:
      color var(--dur-fast) var(--ease-out-quart),
      background-color var(--dur-fast) var(--ease-out-quart);
  }

  .lang__link:hover {
    color: var(--ink);
  }

  /* The active language is marked by weight and a filled chip, not colour
     alone, so it still reads as selected without seeing the difference. */
  .lang__link[aria-current] {
    color: var(--ink);
    background: rgb(var(--ring-ch) / 0.18);
  }

  /* The full name exists for screen readers; sighted users get the code, which
     is what fits in a bar. */
  .lang__full {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .mark {
    justify-self: start;
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    color: var(--ink);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  /* the real mark, not a lambda glyph typed in the body font. width/height are
     the intrinsic pixels so the box is reserved before it decodes and the bar
     never shifts. */
  /* 1.6em against a 1.25rem wordmark = ~32px in a 72px bar. 1.25em (22px) was
     too small for the mark's shading to resolve; 2.1em (42px) overpowered the
     wordmark beside it. This sits between them and matches the text's weight.
     decoding="sync" on the element: the logo is above the fold, and an async
     decode lets it arrive a frame late, which reads as the brand popping in. */
  .mark__glyph {
    inline-size: auto;
    block-size: 1.6em;
    align-self: center;
  }

  .mark__word {
    transition: color var(--dur-fast) var(--ease-out-quart);
  }

  .mark:hover .mark__word {
    color: var(--ring);
  }

  .bar__nav {
    display: none;
    justify-self: center;
    gap: clamp(1.15rem, 2.2vw, 2.5rem);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
  }

  .bar__nav a {
    position: relative;
    color: var(--ink-muted);
    text-decoration: none;
    padding-block: 0.5rem;
    transition: color var(--dur-fast) var(--ease-out-quart);
  }

  /* the rule grows from the centre on hover: the whole interaction budget for
     a nav link, and enough to make it feel alive without a colour change */
  .bar__nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0.15rem;
    height: 1px;
    background: var(--ring);
    transform: scaleX(0);
    transition: transform var(--dur-base) var(--ease-out-quart);
  }

  .bar__nav a:hover {
    color: var(--ink);
  }

  .bar__nav a:hover::after {
    transform: scaleX(1);
  }

  .bar__cta {
    justify-self: end;
    /* the same frosted pill as the hero, one step smaller so the hero's stays
       the primary action on the screen */
    min-height: 2.6rem;
    padding: 0.55rem 1.15rem;
    font-size: var(--text-sm);
  }

  /* 66rem, not 58: the same bar carries both languages, and the French labels
     run long enough that at 960px the action pill was clipped off the right
     edge. A breakpoint that fits one language and breaks the other is not a
     breakpoint. Measured against the longest French set. */
  /* Below 40rem the bar carries the mark, the language pair and the action, and
     the wordmark is what has to give. The breakpoint is measured, not chosen:
     the wordmark and the language pills stay clear of each other down to 640px
     and not below it. The mark alone still identifies the brand, and the full
     name is one scroll away in the footer. */
  /* Below the breakpoint that reveals the centre nav there is no centre column
     to balance, and `1fr auto 1fr` actively hurts: it forces the outer tracks
     to equal width, so the wider end group (language + action) overflows its
     track leftward and lands on the wordmark — a measured -10px overlap from
     440px to ~600px. Flex lets both groups size to their content. */
  @media (max-width: 65.999rem) {
    .bar__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
    }
  }

  @media (max-width: 40rem) {
    .mark__word {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .mark__glyph {
      block-size: 1.9em;
    }
  }

  @media (min-width: 66rem) {
    .bar__nav {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar,
    .mark__word,
    .bar__nav a,
    .bar__nav a::after {
      transition: none;
    }
  }
</style>

<script>
  // The bar only becomes a surface once it has left the photograph.
  // isIntersecting alone is false both above AND below the viewport, so the
  // sentinel's position is checked explicitly.
  const bar = document.querySelector<HTMLElement>('[data-bar]');
  const sentinel = document.querySelector('[data-hero-end]');

  if (bar && sentinel && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        const passed = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        bar.toggleAttribute('data-scrolled', passed);
      },
      { threshold: 0 }
    );
    observer.observe(sentinel);
  } else if (bar) {
    // No hero on this page, so there is no sentinel to watch. Without this the
    // bar stays transparent over the whole document and its links sit on
    // whatever happens to scroll under them. Both current pages render a hero,
    // so this branch has never fired — which is exactly why it is easy to lose.
    bar.toggleAttribute('data-scrolled', true);
  }
</script>
